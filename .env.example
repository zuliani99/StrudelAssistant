# Required: OpenAI API key, used by both the chat backend and the embedding script
OPENAI_API_KEY=sk-proj-...

# Optional: chat model to use (default: gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: if set, the assistant can use the "search_web" tool (Tavily)
# to look up information not covered by Strudel's local documentation
TAVILY_API_KEY=tvly...

# Optional: tracing/observability for LLM calls with LangSmith
# (without these variables the app works normally, just without tracing)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT="Strudel Repl"

# Optional: Pinecone API key, used by the embedding script to store and query embeddings
PINECONE_API_KEY=pcsk_...